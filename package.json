{
  "name": "synchronic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/build-data.ts && next dev",
    "build": "tsx scripts/build-data.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsx scripts/build-data.ts && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:validate": "tsx scripts/validate-data.ts",
    "spike:iran": "tsx scripts/spike-iran-heads-of-state.ts",
    "fetch:flags": "tsx scripts/fetch-flags.ts",
    "mirror:flags": "tsx scripts/mirror-flags.ts",
    "fetch:hog": "tsx scripts/fetch-heads-of-government.ts",
    "merge:hog": "tsx scripts/merge-heads-of-government.ts",
    "data:build": "tsx scripts/build-data.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.12.3",
  "license": "MIT"
}
